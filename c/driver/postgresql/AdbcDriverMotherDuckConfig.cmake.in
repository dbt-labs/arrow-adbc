@PACKAGE_INIT@

set(ADBC_VERSION "@ADBC_VERSION@")

if("@ADBC_BUILD_STATIC@")
  find_package(AdbcDriverCommon QUIET)
  find_package(AdbcDriverFramework QUIET)
  find_package(fmt QUIET)
  find_package(nanoarrow QUIET)
  if(WIN32)
    find_package(PostgreSQL QUIET)
  else()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_check_modules(ADBC_MOTHERDUCK_LIBPQ QUIET libpq)
      if(ADBC_MOTHERDUCK_LIBPQ_FOUND
         AND NOT TARGET AdbcDriverMotherDuck::libpq_static)
        add_library(AdbcDriverMotherDuck::libpq_static INTERFACE IMPORTED)
        set_target_properties(
          AdbcDriverMotherDuck::libpq_static
          PROPERTIES INTERFACE_LINK_LIBRARIES
                     "${ADBC_MOTHERDUCK_LIBPQ_STATIC_LDFLAGS}")
      endif()
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AdbcDriverMotherDuckTargets.cmake")

check_required_components(AdbcDriverMotherDuck)
